From f24683cec85a27b45d7105fc630206a704d9a0ac Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 13 Oct 2026 00:24:48 +0000
Subject: [PATCH 02/10] fix: escuchar antes de bajar acepta formatos sin
 protocolo declarado
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Sin procesar, los formatos de los extractores propios no traen «protocol»
(lo rellena el motor al procesar), y _elegir_pista los descartaba todos:
la escucha previa de Audius o Jamendo acababa en «no ofrece una pista
reproducible». Si no lo dicen, manda la dirección.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HgAzPqzMyDgbtuBYhjZEkH
---
 descargador/infrastructure.py |  5 ++++-
 tests/test_downloader.py      | 12 ++++++++++++
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/descargador/infrastructure.py b/descargador/infrastructure.py
index dda6d6d..1beb2ac 100644
--- a/descargador/infrastructure.py
+++ b/descargador/infrastructure.py
@@ -748,12 +748,15 @@ class YtDlpDownloader:
             if combinados:
                 return max(combinados, key=lambda f: f.get("height") or 0)
 
+        # Sin procesar, los formatos de los extractores propios (Audius,
+        # Jamendo, Commons, ccMixter) no dicen su protocolo, porque eso lo
+        # rellena el motor al procesar. Entonces manda la propia dirección.
         audios = [
             f for f in formatos
             if f.get("url")
             and f.get("acodec") not in (None, "none")
             and f.get("vcodec") in (None, "none")
-            and str(f.get("protocol") or "").startswith("http")
+            and str(f.get("protocol") or f["url"]).startswith("http")
         ]
         if audios:
             return max(audios, key=lambda f: f.get("abr") or 0)
diff --git a/tests/test_downloader.py b/tests/test_downloader.py
index 6815b9f..81ff9e5 100644
--- a/tests/test_downloader.py
+++ b/tests/test_downloader.py
@@ -1015,6 +1015,18 @@ class StreamTests(unittest.TestCase):
         pista = YtDlpDownloader._elegir_pista(self.FORMATOS, audio_only=True)
         self.assertEqual(pista["url"], "https://cdn/mejor")
 
